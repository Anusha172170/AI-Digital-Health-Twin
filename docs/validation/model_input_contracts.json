{
  "diabetes": {
    "target": "Outcome",
    "target_definition": "PIMA recorded diabetes status; not prospective diabetes incidence",
    "features": {
      "pregnancies": {
        "unit": "count",
        "context": "clinical_baseline",
        "required": true
      },
      "glucose": {
        "unit": "mg/dL",
        "context": "two_hour_ogtt_plasma",
        "required": true
      },
      "diastolic_bp": {
        "unit": "mmHg",
        "context": "clinical_baseline",
        "required": true
      },
      "skin_thickness": {
        "unit": "mm",
        "context": "clinical_baseline",
        "required": true
      },
      "insulin": {
        "unit": "uU/mL",
        "context": "two_hour_insulin",
        "required": true
      },
      "bmi": {
        "unit": "kg/m2",
        "context": "clinical_baseline",
        "required": true
      },
      "pedigree": {
        "unit": "dimensionless",
        "context": "clinical_baseline",
        "required": true
      },
      "age": {
        "unit": "years",
        "context": "clinical_baseline",
        "required": true
      }
    },
    "clinical_deployment_allowed": false
  },
  "cvd": {
